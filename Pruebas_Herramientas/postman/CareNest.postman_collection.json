        {
          "name": "PM-03 Iniciar sesión (paciente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PM-03 · Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test('PM-03 · Devuelve un token JWT', () => {",
                  "    pm.expect(datos.token).to.be.a('string');",
                  "    pm.expect(datos.token.split('.')).to.have.lengthOf(3);",
                  "});",
                  "pm.test('PM-03 · El rol es PACIENTE', () => pm.expect(JSON.stringify(datos)).to.include('PACIENTE'));",
                  "pm.collectionVariables.set('tokenPaciente', datos.token);"
                ]
              }
            }
          ],
          "request": {
