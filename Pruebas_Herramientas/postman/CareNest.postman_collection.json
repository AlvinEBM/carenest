{
  "info": {
    "name": "CareNest – Pruebas de API",
    "description": "Pruebas de la API de CareNest (Calidad y Pruebas de Software, UPN). Ejecutar en orden con el Collection Runner o con Newman. Requiere el backend en http://localhost:3002.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "PM-01 Registrar paciente nuevo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fechas de prueba: días laborables (sin domingos) a 3 y 4 días de hoy",
                  "function laborable(dias) {",
                  "    const d = new Date();",
                  "    let n = 0;",
                  "    while (n < dias) { d.setDate(d.getDate() + 1); if (d.getDay() !== 0) n++; }",
                  "    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
                  "}",
                  "pm.collectionVariables.set('fecha', laborable(3));",
                  "pm.collectionVariables.set('fechaNueva', laborable(4));",
                  "// Paciente nuevo en cada ejecución (DNI, teléfono y correo únicos)",
                  "const n = String(Date.now()).slice(-7);",
                  "pm.collectionVariables.set('dni', '7' + n);",
                  "pm.collectionVariables.set('telefono', '98' + n);",
                  "pm.collectionVariables.set('correo', 'postman.' + n + '@gmail.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PM-01 · Responde 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('PM-01 · Devuelve ok = true', () => pm.expect(pm.response.json().ok).to.eql(true));",
                  "pm.test('PM-01 · Responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Crea un paciente nuevo con datos únicos generados en el pre-request.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Rosa\",\n  \"apellidos\": \"Postman Prueba\",\n  \"dni\": \"{{dni}}\",\n  \"telefono\": \"{{telefono}}\",\n  \"correo\": \"{{correo}}\",\n  \"contrasena\": \"Postman2026\",\n  \"genero\": \"Femenino\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
